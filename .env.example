# ==============================================================================
# SafeTour Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running the application:
#   cp .env.example .env
#
# Obtain project credentials from your team lead or Supabase Dashboard.
#
# SafeTour operates offline-first: if keys are omitted, the app will run with
# pre-bundled offline datasets for 100 Bengaluru localities.
# ==============================================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (for Flutter client-side access)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (OPTIONAL: only needed for running backend seed scripts)
# NEVER expose this key in client-side code or public repositories!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
